generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FeederState {
  OPEN
  CLOSED
}

enum EventType {
  CAT_APPROACHED
  CAT_LEFT
  FEEDER_OPENED
  FEEDER_CLOSED
  HARDWARE_ERROR
  APP_COMMAND
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  avatarUrl    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  resetToken   ResetToken?
  
  userFeeders  UserFeeder[]
  userCats     UserCat[]

  events       FeedingEvent[]
}

model ResetToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feeder {
  id           String      @id @default(uuid())
  name         String
  deviceId     String      @unique
  
  desiredState FeederState @default(CLOSED)
  actualState  FeederState @default(CLOSED)
  
  lastPing     DateTime    @default(now()) 
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  userFeeders  UserFeeder[]
  feederCats   FeederCat[]

  events       FeedingEvent[]
}

model Cat {
  id         String   @id @default(uuid())
  name       String
  
  bleMac     String?  @unique 
  
  photos     Photo[]
  events     FeedingEvent[]

  userCats   UserCat[]
  feederCats FeederCat[]
}

model Photo {
  id        String   @id @default(uuid())
  filename  String
  
  catId     String
  cat       Cat      @relation(fields: [catId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
}

model FeedingEvent {
  id         String    @id @default(uuid())
  
  feederId   String
  feeder     Feeder    @relation(fields: [feederId], references: [id], onDelete: Cascade)
  
  catId      String?     
  cat        Cat?      @relation(fields: [catId], references: [id], onDelete: Cascade)
  
  userId     String?   
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  eventType  EventType
  metadata   Json?

  createdAt  DateTime  @default(now())
}


model UserFeeder {
  userId   String
  feederId String
  role     String @default("OWNER")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeder   Feeder @relation(fields: [feederId], references: [id], onDelete: Cascade)

  @@id([userId, feederId])
}

model UserCat {
  userId String
  catId  String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cat    Cat  @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@id([userId, catId])
}

model FeederCat {
  feederId String
  catId    String

  feeder   Feeder @relation(fields: [feederId], references: [id], onDelete: Cascade)
  cat      Cat    @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@id([feederId, catId])
}